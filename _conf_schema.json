{
  "provider": {
    "description": "文生图/图生图服务提供商",
    "type": "string",
    "default": "openai",
    "options": [
      "openai",
      "apikey",
      "packy",
      "packy_optimized",
      "siliconflow",
      "zhipu",
      "volcengine",
      "custom"
    ],
    "labels": [
      "OpenAI（国际）",
      "apikey.fan 聚合",
      "Packy / API.FAN（GPT-Image 全球线路）",
      "Packy / API.FAN（GPT-Image 优化线路）",
      "硅基流动 SiliconFlow",
      "智谱 AI BigModel",
      "火山方舟（豆包）",
      "自定义 / OpenAI 兼容"
    ],
    "hint": "选择提供商后会自动填充模型 URL 与推荐模型；自定义可填写任意 OpenAI 兼容接口。",
    "invisible": true
  },
  "base_url": {
    "description": "模型服务 API 地址（Base URL）",
    "type": "string",
    "default": "https://api.openai.com/v1",
    "hint": "通常以 /v1 结尾。选择内置提供商会自动填入，也可手动修改。",
    "invisible": true
  },
  "api_key": {
    "description": "API Key",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "仅保存在本机插件配置中，请勿泄露。",
    "invisible": true
  },
  "model": {
    "description": "默认模型",
    "type": "string",
    "default": "gpt-image-1",
    "hint": "可留空使用提供商默认模型，或在可视化视图中点击“检测可用模型”后选择。",
    "invisible": true
  },
  "size": {
    "description": "图片尺寸",
    "type": "string",
    "default": "1024x1024",
    "options": [
      "auto",
      "1024x1024",
      "1536x1024",
      "1024x1536",
      "2048x2048",
      "2048x1152",
      "3840x2160",
      "2160x3840",
      "768x1024",
      "1024x768",
      "512x512"
    ],
    "hint": "部分模型只支持特定尺寸。",
    "invisible": true
  },
  "quality": {
    "description": "图片质量",
    "type": "string",
    "default": "auto",
    "options": [
      "auto",
      "high",
      "medium",
      "low"
    ],
    "hint": "部分模型不支持该参数，可忽略。",
    "invisible": true
  },
  "n": {
    "description": "生成数量",
    "type": "int",
    "default": 1,
    "slider": {
      "min": 1,
      "max": 4,
      "step": 1
    },
    "invisible": true
  },
  "stream": {
    "description": "启用 SSE 流式返回",
    "type": "bool",
    "default": false,
    "hint": "apikey.fan 的 gpt-image-2 等模型需要开启流式；其它提供商通常关闭即可。",
    "invisible": true
  },
  "response_format": {
    "description": "返回格式",
    "type": "string",
    "default": "b64_json",
    "options": [
      "b64_json",
      "url"
    ],
    "hint": "b64_json 最通用，便于直接保存和发送图片。",
    "invisible": true
  },
  "t2i_path": {
    "description": "文生图接口路径",
    "type": "string",
    "default": "/images/generations",
    "invisible": true
  },
  "i2i_path": {
    "description": "图生图接口路径",
    "type": "string",
    "default": "/images/edits",
    "invisible": true
  },
  "timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "default": 300,
    "slider": {
      "min": 10,
      "max": 900,
      "step": 10
    },
    "invisible": true
  },
  "allow_commands": {
    "description": "启用聊天指令（/文生图、/图生图）",
    "type": "bool",
    "default": true
  },
  "register_llm_tools": {
    "description": "向 AI 智能体注册文生图/图生图工具",
    "type": "bool",
    "default": true,
    "hint": "开启后，机器人在对话中可按需调用 text_to_image 与 image_to_image 工具。"
  },
  "allowed_users": {
    "description": "允许使用指令的用户（留空表示所有人）",
    "type": "list",
    "default": [],
    "_special": "sender_id"
  },
  "output_format": {
    "description": "输出格式（Packy / GPT-Image）",
    "type": "string",
    "default": "png",
    "options": [
      "png",
      "jpeg",
      "webp"
    ],
    "hint": "仅对 Packy 等支持 output_format 的服务生效，优先使用 png。",
    "invisible": true
  },
  "output_compression": {
    "description": "JPEG 压缩质量（0-100）",
    "type": "int",
    "default": 90,
    "slider": {
      "min": 0,
      "max": 100,
      "step": 1
    },
    "hint": "仅在 output_format=jpeg 时生效。",
    "invisible": true
  },
  "svg_width": {
    "description": "SVG 默认宽度（0 表示按 SVG 自身尺寸）",
    "type": "int",
    "default": 0,
    "slider": {
      "min": 0,
      "max": 8192,
      "step": 1
    },
    "hint": "仅用于 SVG 绘图；0 表示不强制宽度，按 SVG 的 width/viewBox 计算。"
  },
  "svg_height": {
    "description": "SVG 默认高度（0 表示按 SVG 自身尺寸）",
    "type": "int",
    "default": 0,
    "slider": {
      "min": 0,
      "max": 8192,
      "step": 1
    },
    "hint": "仅用于 SVG 绘图；0 表示不强制高度，按 SVG 的 height/viewBox 计算。"
  },
  "svg_background": {
    "description": "SVG 默认背景色",
    "type": "string",
    "default": "#ffffff",
    "hint": "填写 transparent 可输出透明背景的 PNG。"
  },
  "svg_max_dimension": {
    "description": "SVG 最大输出边长",
    "type": "int",
    "default": 4096,
    "slider": {
      "min": 64,
      "max": 8192,
      "step": 64
    },
    "hint": "防止过大 SVG 占用内存；超出时会等比缩小。"
  },
  "motion_default_format": {
    "description": "动画默认输出格式",
    "type": "string",
    "default": "gif",
    "options": [
      "gif",
      "webp",
      "mp4"
    ],
    "hint": "gif 适合聊天平台直接显示；mp4 更适合较长或较复杂的动画；webp 体积较小但平台支持不一。"
  },
  "motion_width": {
    "description": "动画默认宽度",
    "type": "int",
    "default": 640,
    "slider": {
      "min": 240,
      "max": 1280,
      "step": 2
    }
  },
  "motion_height": {
    "description": "动画默认高度",
    "type": "int",
    "default": 360,
    "slider": {
      "min": 240,
      "max": 1280,
      "step": 2
    }
  },
  "motion_fps": {
    "description": "动画默认帧率",
    "type": "int",
    "default": 12,
    "slider": {
      "min": 5,
      "max": 24,
      "step": 1
    },
    "hint": "GIF 建议 12 到 15 帧；MP4 可用 20 到 24 帧。"
  },
  "motion_max_duration": {
    "description": "动画最大时长（秒）",
    "type": "int",
    "default": 15,
    "slider": {
      "min": 2,
      "max": 60,
      "step": 1
    }
  },
  "motion_max_frames": {
    "description": "动画最大帧数",
    "type": "int",
    "default": 360,
    "slider": {
      "min": 10,
      "max": 600,
      "step": 10
    },
    "hint": "GIF/WebP 会自动限制在 180 帧以内。"
  },
  "motion_max_dimension": {
    "description": "动画最大边长",
    "type": "int",
    "default": 1280,
    "slider": {
      "min": 240,
      "max": 4096,
      "step": 64
    }
  },
  "motion_max_file_mb": {
    "description": "动画最大文件大小（MB）",
    "type": "int",
    "default": 20,
    "slider": {
      "min": 1,
      "max": 100,
      "step": 1
    }
  },
  "motion_video_as_file": {
    "description": "MP4 以文件形式发送",
    "type": "bool",
    "default": false,
    "hint": "部分平台视频上传受限时，可开启后以文件发送。"
  },
  "motion_max_concurrency": {
    "description": "动画最大并发渲染数",
    "type": "int",
    "default": 1,
    "slider": {
      "min": 1,
      "max": 4,
      "step": 1
    },
    "hint": "同时生成多个动画会占用较多 CPU，建议保持 1 到 2。"
  }
}
